# ───────────────────────── Indispensable ─────────────────────────

# Adresse publique du site, sans barre finale. Sert aux redirections OAuth :
# elle doit correspondre EXACTEMENT à ce que tu déclares chez Google et TikTok.
APP_URL="http://localhost:3000"

# Clé de chiffrement des jetons TikTok/YouTube stockés en base (32 caractères minimum).
# Génère-la une fois avec :  openssl rand -base64 32
# Ne la change plus ensuite : les comptes déjà connectés deviendraient illisibles.
ENCRYPTION_KEY=""

# Mot de passe de la base Postgres du docker-compose.
POSTGRES_PASSWORD="change-moi"

# Hors Docker uniquement (avec Docker, docker-compose fournit ces deux valeurs) :
# DATABASE_URL="postgresql://cliping:cliping@localhost:5432/cliping"
# DATA_DIR="./data"

# Mets "false" une fois ton compte créé pour fermer les inscriptions (usage perso).
ALLOW_SIGNUP="true"

# Avec le profil HTTPS de docker-compose : ton nom de domaine (ex. clips.mondomaine.fr).
# DOMAIN=""

# ───────────────────────── Publication ─────────────────────────

# YouTube — console.cloud.google.com → API « YouTube Data API v3 » → identifiants OAuth « Application Web ».
# URI de redirection à déclarer :  {APP_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TikTok — developers.tiktok.com → produits « Login Kit » + « Content Posting API ».
# URI de redirection à déclarer :  {APP_URL}/api/oauth/tiktok/callback   (HTTPS obligatoire)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Pour que la page Performances relève les vues de tes vidéos TikTok : ajoute le droit « video.list »
# à ton application TikTok, passe cette valeur à "true", redémarre, puis reconnecte tes comptes TikTok.
# Laisse "false" tant que le droit n'est pas activé côté TikTok : la connexion des comptes serait refusée.
# TIKTOK_STATS_SCOPE="false"

# Instagram Reels — developers.facebook.com → créer une app (cas d'usage « Gérer les messages et le contenu
# sur Instagram ») → « API setup with Instagram login ». Comptes Instagram professionnels (Business ou Créateur).
# Copie l'« Instagram app ID » et l'« Instagram app secret » (pas ceux de l'app Facebook).
# URI de redirection à déclarer :  {APP_URL}/api/oauth/instagram/callback   (HTTPS obligatoire)
# Instagram vient chercher la vidéo à une adresse publique temporaire : APP_URL doit être joignable depuis Internet.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# INSTAGRAM_API_VERSION="v24.0"

# ───────────────────────── Découverte des lives (facultatif) ─────────────────────────

# « En live maintenant » (page Streamers) et mode automatique : lecture de l'annuaire public des lives.
# Twitch — dev.twitch.tv/console → « Enregistrer votre application » (URL de redirection http://localhost,
# type « Confidentiel »), puis copie l'identifiant client et génère un secret. Aucun compte n'est connecté.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# Kick (en plus de Twitch) — réglages développeur de ton compte Kick → créer une application.
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""
# DISCOVERY_INTERVAL_SEC=120       # fréquence d'actualisation du classement et du mode automatique

# ───────────────────────── Intelligence (facultatif mais recommandé) ─────────────────────────

# Titres, accroches, hashtags et note de potentiel rédigés par Claude. Sans clé : l'accroche et le titre reprennent une phrase du streamer.
ANTHROPIC_API_KEY=""
# Modèle utilisé (défaut : claude-opus-5-5). Pour réduire le coût sur de gros volumes : claude-haiku-5-5
# AI_MODEL="claude-opus-5-5"

# Sous-titres : n'importe quelle API de transcription compatible OpenAI.
#   OpenAI : TRANSCRIBE_API_URL="https://api.openai.com/v1"        TRANSCRIBE_MODEL="whisper-1"
#   Groq   : TRANSCRIBE_API_URL="https://api.groq.com/openai/v1"   TRANSCRIBE_MODEL="whisper-large-v3-turbo"
#   Local, gratuit (scripts/whisper-setup.sh puis scripts/whisper-server.py) :
#            TRANSCRIBE_API_URL="http://127.0.0.1:8770/v1"  TRANSCRIBE_API_KEY="local"  TRANSCRIBE_MODEL="large-v3-turbo"
TRANSCRIBE_API_URL=""
TRANSCRIBE_API_KEY=""
# TRANSCRIBE_MODEL="whisper-1"

# ───────────────────────── Réglages du bot (valeurs par défaut entre parenthèses) ─────────────────────────

# MONITOR_INTERVAL_SEC=60          # fréquence de vérification « en live ? » par chaîne
# MAX_CONCURRENT_RECORDINGS=6      # lives captés en même temps (≈ 1 cœur et 0,5 Go de disque par live en 1080p)
# JOB_CONCURRENCY=2                # montages / publications en parallèle
# SEGMENT_SEC=20                   # durée des segments d'enregistrement
# BUFFER_SEC=300                   # tampon glissant gardé sur disque par live
# CHAT_LAG_SEC=5                   # retard moyen du chat sur l'image
# VIDEO_ANALYSIS="keyframes"       # keyframes (léger) | full (précis, gourmand) | off
# RENDER_FPS=30                    # images/seconde des clips montés
# X264_PRESET="veryfast"           # plus lent = fichiers plus légers à qualité égale
# MAX_VOD_HOURS=6                  # durée max d'un replay importé d'un coup
# SHORT_VIDEO_MAX_SEC=150          # en dessous, une vidéo importée (clip, Short, TikTok) devient directement un clip
# MAX_STREAMERS_PER_USER=50
# STREAMLINK_ARGS=""               # options supplémentaires passées à streamlink
# YTDLP_ARGS=""                    # options supplémentaires passées à yt-dlp (ex. --cookies /data/cookies.txt)
# EXTRA_SOURCE_HOSTS=""            # hôtes vidéo supplémentaires autorisés, séparés par des virgules

# ───────────────────────── Notifications (facultatif) ─────────────────────────
# Les notifications de l'app (Web Push) marchent sans rien régler : une paire de clés VAPID est générée
# au premier usage et gardée en base (clé privée chiffrée). Pour la fixer toi-même (npx web-push generate-vapid-keys) :
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:toi@exemple.fr"   # contact demandé par les services de push (par défaut : APP_URL si https)
# NOTIFY_EXTRA_HOSTS=""             # ton propre serveur ntfy (ex. ntfy.mondomaine.fr), séparés par des virgules
