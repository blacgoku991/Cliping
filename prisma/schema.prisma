generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Utilisateurs & sessions ─────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  /// Préférences de clipping (voir src/lib/settings.ts)
  settings     Json     @default("{}")
  /// Coach : liste de contrôle cochée, brouillons de profil (voir src/lib/coach)
  coach        Json     @default("{}")
  createdAt    DateTime @default(now())

  sessions     Session[]
  streamers    Streamer[]
  recordings   Recording[]
  clips        Clip[]
  accounts     SocialAccount[]
  publications Publication[]
  discovery    Discovery?
  compilations Compilation[]
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 du jeton stocké dans le cookie (le jeton en clair n'est jamais en base)
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Sources (streamers surveillés) ─────────────────────────

enum SourcePlatform {
  TWITCH
  KICK
  YOUTUBE
  TIKTOK
  OTHER
}

model Streamer {
  id          String         @id @default(cuid())
  userId      String
  platform    SourcePlatform
  /// Identifiant de chaîne normalisé (login Twitch, slug Kick, @handle YouTube…)
  login       String
  url         String
  displayName String
  enabled     Boolean        @default(true)
  /// Liste de catégories séparées par des virgules ; vide = tout enregistrer
  gameFilter  String         @default("")
  quality     String         @default("best")
  /// Zone facecam en fractions de l'image source {x,y,w,h} (pour le template FACECAM)
  facecam     Json?

  isLive        Boolean   @default(false)
  liveTitle     String?
  liveCategory  String?
  lastCheckedAt DateTime?
  lastLiveAt    DateTime?
  lastError     String?
  /// Vrai = ajoutée par le mode automatique de la découverte (retirée par lui quand elle sort du classement).
  /// Les chaînes ajoutées à la main restent à false et ne sont jamais touchées par ce mode.
  autoFollowed  Boolean   @default(false)
  /// Spectateurs lors du dernier passage de la découverte (chaînes suivies automatiquement)
  autoViewers   Int?
  createdAt     DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordings Recording[]
  clips      Clip[]

  @@unique([userId, platform, login])
  @@index([enabled])
}

enum RecordingSource {
  LIVE
  VOD
}

enum RecordingStatus {
  PENDING
  RECORDING
  PROCESSING
  DONE
  FAILED
}

model Recording {
  id          String          @id @default(cuid())
  userId      String
  streamerId  String?
  source      RecordingSource
  sourceUrl   String
  status      RecordingStatus @default(PENDING)
  title       String?
  category    String?
  /// Nom de la chaîne d'origine (imports de VOD sans streamer associé)
  author      String?
  /// Durée analysée, en secondes
  durationSec Float           @default(0)
  /// Progression 0..1 (import VOD)
  progress    Float           @default(0)
  /// Options d'import (plage, nombre max de clips…)
  options     Json            @default("{}")
  /// Courbe du score du détecteur sur les dernières minutes {from, step, threshold, points[]} (lives en cours)
  intensity   Json?
  error       String?
  startedAt   DateTime        @default(now())
  endedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamer Streamer? @relation(fields: [streamerId], references: [id], onDelete: SetNull)
  clips    Clip[]

  @@index([userId, startedAt])
  @@index([status])
}

// ───────────────────────── Clips ─────────────────────────

enum ClipStatus {
  PROCESSING
  READY
  APPROVED
  REJECTED
  FAILED
}

enum ClipTemplate {
  BLUR
  FULL
  FACECAM
}

model Clip {
  id          String       @id @default(cuid())
  userId      String
  recordingId String?
  streamerId  String?
  status      ClipStatus   @default(PROCESSING)
  template    ClipTemplate @default(BLUR)

  /// Position, dans l'enregistrement d'origine, du début de source.mp4 (secondes)
  originSec Float @default(0)
  /// Moment fort et fenêtre du clip, en secondes à l'intérieur de source.mp4
  peakSec   Float
  startSec  Float
  endSec    Float
  /// Durée totale de source.mp4 (marge incluse, pour pouvoir re-découper)
  sourceDur Float @default(0)
  /// Score de viralité 0..100
  score     Int   @default(0)
  /// Détail des signaux {audio, chat, scene, ai, reason}
  signals   Json  @default("{}")

  title        String   @default("")
  hook         String   @default("")
  description  String   @default("")
  hashtags     String[] @default([])
  /// Transcription mot à mot [{w, s, e}] relative au début de source.mp4
  transcript   Json?
  captions     Boolean  @default(true)
  /// Kit de publication généré par le coach (légendes, commentaires à épingler…), voir src/lib/coach
  publishKit   Json?
  /// Options de montage propres au clip {coldOpen, trimSilence, punchZoom, progressBar, endCard, captionStyle} ;
  /// une clé absente reprend le réglage par défaut de l'utilisateur
  edit         Json     @default("{}")
  /// Résumé du dernier montage {duration, teaserDur, removed, cuts, peakOut, bounds}
  montage      Json?
  /// Variantes proposées (IA ou par défaut) parmi lesquelles l'utilisateur choisit dans l'éditeur
  hookOptions  String[] @default([])
  titleOptions String[] @default([])
  /// Mots à mettre en valeur dans les sous-titres (forme normalisée)
  emphasis     String[] @default([])

  /// Noms de fichiers relatifs au dossier du clip
  hasFinal   Boolean   @default(false)
  renderedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recording        Recording?        @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  streamer         Streamer?         @relation(fields: [streamerId], references: [id], onDelete: SetNull)
  publications     Publication[]
  compilationItems CompilationItem[]

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────── Comptes sociaux & publications ─────────────────────────

enum SocialPlatform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
}

model SocialAccount {
  id              String         @id @default(cuid())
  userId          String
  platform        SocialPlatform
  /// ID de chaîne YouTube ou open_id TikTok
  externalId      String
  displayName     String
  handle          String?
  avatarUrl       String?
  /// Jetons chiffrés AES-256-GCM (voir src/lib/crypto.ts)
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  scopes          String         @default("")
  /// Faux = le jeton a été révoqué ou n'a pas pu être rafraîchi : reconnexion requise
  valid           Boolean        @default(true)
  /// Profil proposé par le coach (bios, idées de nom) et ce qui a servi à le générer
  profileKit      Json?
  /// Visibilité appliquée par défaut aux publications de ce compte (null = celle de la plateforme)
  defaultPrivacy  String?
  /// Nombre max de publications sur 24 heures glissantes (null = pas de plafond)
  dailyCap        Int?
  /// Dernier « tester la connexion » réussi
  checkedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@unique([userId, platform, externalId])
}

enum PublicationStatus {
  QUEUED
  UPLOADING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELED
}

/// Une publication porte soit un clip (vertical), soit une compilation (vidéo YouTube classique) :
/// exactement l'un des deux est renseigné (contrainte CHECK dans la migration).
model Publication {
  id            String            @id @default(cuid())
  userId        String
  clipId        String?
  compilationId String?
  accountId     String
  status        PublicationStatus @default(QUEUED)
  title         String
  description   String            @default("")
  /// public | unlisted | private (YouTube) — public | followers | friends | private | draft (TikTok)
  privacy       String            @default("public")
  scheduledAt   DateTime          @default(now())
  publishedAt   DateTime?
  /// ID de la vidéo côté plateforme (videoId YouTube, publish_id / post id TikTok)
  externalId    String?
  externalUrl   String?
  /// Information non bloquante renvoyée par la plateforme (ex. « envoyé dans tes brouillons »)
  note          String?
  /// État d'envoi repris en cas de nouvelle tentative (URI de session d'upload…)
  uploadState   Json?
  error         String?
  createdAt     DateTime          @default(now())

  /// Suivi des performances (voir src/worker/stats.ts) : dernier relevé connu
  viewCount    Int?
  likeCount    Int?
  commentCount Int?
  /// Absent sur YouTube (l'API ne donne pas les partages)
  shareCount   Int?
  /// null = pas encore relevé · OK · DRAFT (brouillon TikTok, pas d'identifiant public) · NO_SCOPE (autorisation manquante)
  /// NO_ID (identifiant public inconnu) · NOT_FOUND (vidéo supprimée) · ENDED (suivi terminé) · ERROR
  statsStatus  String?
  statsError   String?
  statsAt      DateTime?
  /// Prochain relevé prévu (plus fréquent dans les premières heures)
  statsNextAt  DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip        Clip?             @relation(fields: [clipId], references: [id], onDelete: Cascade)
  compilation Compilation?      @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  account     SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stats       PublicationStat[]

  @@index([userId, createdAt])
  @@index([clipId])
  @@index([compilationId])
  @@index([status, statsNextAt])
}

/// Historique des relevés de performances d'une publication (pour tracer les courbes)
model PublicationStat {
  id            String   @id @default(cuid())
  publicationId String
  userId        String
  at            DateTime @default(now())
  views         Int
  likes         Int?
  comments      Int?
  shares        Int?

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, at])
  @@index([userId, at])
}

// ───────────────────────── Compilations « best-of » (vidéo YouTube horizontale) ─────────────────────────

enum CompilationStatus {
  DRAFT
  RENDERING
  READY
  FAILED
}

model Compilation {
  id          String            @id @default(cuid())
  userId      String
  status      CompilationStatus @default(DRAFT)
  title       String            @default("")
  description String            @default("")
  tags        String[]          @default([])
  /// Texte court incrusté sur la miniature (2 à 4 mots)
  thumbText   String            @default("")
  /// Vrai = titre, description et texte de miniature encore à proposer (IA ou valeurs par défaut) au prochain montage
  metaPending Boolean           @default(true)
  /// Numérotation « compte à rebours » (#10 → #1, le meilleur à la fin) ; faux = 1, 2, 3…
  countdown   Boolean           @default(true)
  captions    Boolean           @default(true)
  /// Ouverture : flash du meilleur moment + titre
  intro       Boolean           @default(true)
  /// D'où vient la proposition {kind: "recording"|"streamer"|"day"|"manual", id?, label}
  origin      Json              @default("{}")
  /// Résultat du dernier montage {duration, intro, outro, moments:[{clipId, at, duration, label}], renderMs}
  montage     Json?
  /// Chapitres du dernier montage [{at, title}] (vide si YouTube ne les afficherait pas)
  chapters    Json?
  hasFinal    Boolean           @default(false)
  hasThumb    Boolean           @default(false)
  progress    Float             @default(0)
  renderedAt  DateTime?
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CompilationItem[]
  publications Publication[]

  @@index([userId, createdAt])
}

model CompilationItem {
  id            String @id @default(cuid())
  compilationId String
  clipId        String
  position      Int
  /// Titre du moment (repère à l'écran et chapitre YouTube)
  label         String @default("")

  compilation Compilation @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  clip        Clip        @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([compilationId, clipId])
  @@index([clipId])
}

// ───────────────────────── Découverte des lives d'un jeu ─────────────────────────

/// « Qui stream ce jeu en ce moment ? » : réglages et dernier classement, rafraîchi par le worker.
model Discovery {
  id         String    @id @default(cuid())
  userId     String    @unique
  /// Nom du jeu tel qu'affiché sur Twitch (ex. « Grand Theft Auto VI »)
  game       String    @default("Grand Theft Auto VI")
  /// Code langue ISO 639-1 (fr, en…) ; vide = toutes les langues
  language   String    @default("fr")
  /// Mode automatique : suivre les N plus gros lives, ajoutés et retirés au fil de l'eau
  autoFollow Boolean   @default(false)
  autoCount  Int       @default(3)
  /// Chaînes que l'utilisateur a retirées à la main : le mode automatique ne les reprend plus
  excluded   String[]  @default([])
  /// Dernier classement [{platform, login, displayName, title, viewers, thumbnailUrl, language, startedAt}]
  results    Json      @default("[]")
  fetchedAt  DateTime?
  error      String?
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────── File de tâches (Postgres, SKIP LOCKED) ─────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
}

/// État partagé entre le worker et le site (battement de cœur, etc.)
model KeyValue {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
